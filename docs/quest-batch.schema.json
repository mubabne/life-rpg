{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life RPG quest batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "period_type", "period_start", "timezone", "quests"],
  "properties": {
    "schema_version": {"const": 1},
    "period_type": {"enum": ["weekly", "monthly"]},
    "period_start": {"type": "string", "format": "date"},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
    "quests": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_key", "title", "description", "stat_tag", "cadence", "difficulty", "estimated_minutes", "due_local_date"],
        "properties": {
          "item_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
          "description": {"type": "string", "maxLength": 2000},
          "stat_tag": {"enum": ["health", "mind", "craft", "social", "wealth"]},
          "cadence": {"enum": ["daily", "weekly", "monthly"]},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
          "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
          "due_local_date": {"type": "string", "format": "date"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"period_type": {"const": "weekly"}}}, "then": {"properties": {"quests": {"items": {"properties": {"cadence": {"enum": ["daily", "weekly"]}}}}}}},
    {"if": {"properties": {"period_type": {"const": "monthly"}}}, "then": {"properties": {"quests": {"items": {"properties": {"cadence": {"const": "monthly"}}}}}}}
  ]
}
